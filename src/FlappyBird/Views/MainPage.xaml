<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FlappyBird.ViewModels"
             xmlns:models="clr-namespace:FlappyBird.Models"
             x:Class="FlappyBird.Views.MainPage" x:DataType="vm:MainViewModel" Title="FlappyBird">
  <Grid Padding="12" RowDefinitions="*,Auto,Auto">
    <ScrollView IsVisible="{Binding IsMenu}">
      <VerticalStackLayout Padding="16,28" Spacing="16" VerticalOptions="Center">
        <Label Text="FLAPPY BIRD" FontSize="38" FontAttributes="Bold" HorizontalTextAlignment="Center" />
        <Label Text="Маленькая птица. Большой рекорд." HorizontalTextAlignment="Center" />
        <Border BackgroundColor="#DCEFEA" StrokeThickness="0" Padding="24" StrokeShape="RoundRectangle 24">
          <VerticalStackLayout><Label Text="ЛИЧНЫЙ РЕКОРД" HorizontalTextAlignment="Center" /><Label Text="{Binding BestScore}" FontSize="56" FontAttributes="Bold" HorizontalTextAlignment="Center" /></VerticalStackLayout>
        </Border>
        <Button Text="Играть" Command="{Binding StartCommand}" />
        <Button Text="Рекорды" Command="{Binding LeaderboardCommand}" />
        <Button Text="Настройки" Command="{Binding SettingsCommand}" />
        <Button Text="Вернуться к результату" Command="{Binding ReturnToResultCommand}" IsVisible="{Binding CanRetrySave}" />
        <Label Text="Касание — взмах. Одна пара труб — одно очко. Рекорды хранятся на этом устройстве." HorizontalTextAlignment="Center" FontSize="14" />
      </VerticalStackLayout>
    </ScrollView>
    <Grid IsVisible="{Binding IsGame}">
      <GraphicsView x:Name="GameCanvas" StartInteraction="OnTouch" />
      <Grid ColumnDefinitions="*,Auto" Padding="16" VerticalOptions="Start">
        <Label Text="{Binding Score}" FontSize="40" FontAttributes="Bold" InputTransparent="True" />
        <Button Grid.Column="1" Text="Ⅱ" Command="{Binding PauseCommand}" WidthRequest="56" SemanticProperties.Description="Пауза" />
      </Grid>
      <Border IsVisible="{Binding IsReady}" InputTransparent="True" BackgroundColor="#EFFFFFFF" Padding="18" HorizontalOptions="Center" VerticalOptions="Center" StrokeShape="RoundRectangle 20">
        <VerticalStackLayout><Label Text="Готов к полёту?" FontSize="26" FontAttributes="Bold" /><Label Text="Нажми на поле, чтобы взлететь" /></VerticalStackLayout>
      </Border>
      <Grid IsVisible="{Binding IsPaused}" BackgroundColor="#B3102A43">
        <ScrollView VerticalOptions="Center">
          <VerticalStackLayout Padding="28" Spacing="14">
            <Label Text="Пауза" TextColor="White" FontSize="32" HorizontalTextAlignment="Center" />
            <Label Text="{Binding CountdownText}" TextColor="White" FontSize="44" HorizontalTextAlignment="Center" />
            <Button Text="Продолжить" Command="{Binding ResumeCommand}" />
            <Button Text="В меню" Command="{Binding MenuCommand}" />
          </VerticalStackLayout>
        </ScrollView>
      </Grid>
      <Grid IsVisible="{Binding IsGameOver}" BackgroundColor="#DDF2F7F8">
        <ScrollView VerticalOptions="Center">
          <VerticalStackLayout Padding="24" Spacing="12">
            <Label Text="{Binding ResultTitle}" FontSize="28" FontAttributes="Bold" HorizontalTextAlignment="Center" />
            <Label Text="{Binding Score, StringFormat='Счёт: {0}'}" FontSize="38" HorizontalTextAlignment="Center" />
            <Label Text="{Binding BestScore, StringFormat='Рекорд: {0}'}" HorizontalTextAlignment="Center" />
            <Label Text="{Binding MedalText}" HorizontalTextAlignment="Center" />
            <Button Text="Ещё раз" Command="{Binding StartCommand}" />
            <Button Text="Повторить сохранение" Command="{Binding SaveResultCommand}" IsVisible="{Binding CanRetrySave}" />
            <Button Text="Не сохранять" Command="{Binding DiscardResultCommand}" IsVisible="{Binding CanRetrySave}" />
            <Button Text="В меню" Command="{Binding MenuCommand}" />
          </VerticalStackLayout>
        </ScrollView>
      </Grid>
    </Grid>
    <Grid IsVisible="{Binding IsLeaderboard}" RowDefinitions="Auto,*,Auto" RowSpacing="12" Padding="12">
      <VerticalStackLayout><Label Text="Лучшие полёты" FontSize="30" FontAttributes="Bold" /><Label Text="10 лучших попыток на этом устройстве" FontSize="14" /></VerticalStackLayout>
      <CollectionView Grid.Row="1" ItemsSource="{Binding Leaders}" SelectionMode="None">
        <CollectionView.ItemTemplate>
          <DataTemplate x:DataType="models:ScoreRow">
            <Border Margin="0,4" Padding="12" StrokeThickness="0" BackgroundColor="#DCEFEA" StrokeShape="RoundRectangle 14">
              <Grid ColumnDefinitions="36,*,60" RowDefinitions="Auto,Auto">
                <Label Text="{Binding Place}" FontSize="22" Grid.RowSpan="2" />
                <Label Grid.Column="1" Text="{Binding Player}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                <Label Grid.Column="1" Grid.Row="1" Text="{Binding Date}" FontSize="12" />
                <Label Grid.Column="2" Text="{Binding Score}" FontSize="24" HorizontalTextAlignment="End" Grid.RowSpan="2" />
              </Grid>
            </Border>
          </DataTemplate>
        </CollectionView.ItemTemplate>
      </CollectionView>
      <HorizontalStackLayout Grid.Row="2" Spacing="12"><Button Text="Назад" Command="{Binding MenuCommand}" /><Button Text="Обновить" Command="{Binding LeaderboardCommand}" /></HorizontalStackLayout>
    </Grid>
    <ScrollView IsVisible="{Binding IsSettings}">
      <VerticalStackLayout Padding="20" Spacing="18">
        <Label Text="Настройки" FontSize="32" FontAttributes="Bold" />
        <Label Text="Имя в таблице рекордов" />
        <Entry Text="{Binding PlayerName}" MaxLength="20" Placeholder="Игрок" />
        <Grid ColumnDefinitions="*,Auto"><Label Text="Звуки" VerticalOptions="Center" /><Switch Grid.Column="1" IsToggled="{Binding SoundEnabled}" /></Grid>
        <Grid ColumnDefinitions="*,Auto"><Label Text="Вибрация" VerticalOptions="Center" /><Switch Grid.Column="1" IsToggled="{Binding VibrationEnabled}" /></Grid>
        <Label Text="Классический режим. Портретная ориентация. Игра работает без интернета." FontSize="14" />
        <Button Text="Сохранить и вернуться" Command="{Binding SaveSettingsCommand}" />
      </VerticalStackLayout>
    </ScrollView>
    <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#116466" />
    <VerticalStackLayout Grid.Row="2" Spacing="4">
      <Label Text="{Binding Status}" FontSize="13" HorizontalTextAlignment="Center" />
      <Button Text="Повторить подключение к базе" Command="{Binding InitializeCommand}" IsVisible="{Binding CanRetryInitialization}" FontSize="12" MinimumHeightRequest="36" />
    </VerticalStackLayout>
  </Grid>
</ContentPage>
