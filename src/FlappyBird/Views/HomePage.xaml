<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:FlappyBird.ViewModels" xmlns:models="clr-namespace:FlappyBird.Models"
    xmlns:controls="clr-namespace:FlappyBird.Views.Controls"
    x:Class="FlappyBird.Views.HomePage" x:DataType="vm:HomeViewModel" Shell.NavBarIsVisible="False" >

  <Grid>
  <ScrollView AutomationProperties.ExcludedWithChildren="{Binding IsSkinPickerOpen}">
    <VerticalStackLayout Padding="22,18,22,28" Spacing="15" MaximumWidthRequest="600">
      <Grid ColumnDefinitions="*,Auto">
        <VerticalStackLayout Spacing="4"><Label Text="FLAPPY / CLUB" Style="{StaticResource Eyebrow}" /><Label Text="Полетели?" Style="{StaticResource PageTitle}" /><Label Text="{Binding Greeting}" Style="{StaticResource Subtitle}" /></VerticalStackLayout>
        <Grid Grid.Column="1" WidthRequest="52" HeightRequest="52" VerticalOptions="Start">
          <Button BackgroundColor="#E2F3EE" CornerRadius="18" Padding="0"
                  SemanticProperties.Description="{Binding SkinButtonDescription}"
                  Command="{Binding OpenSkinPickerCommand}" IsEnabled="{Binding CanInteract}" />
          <controls:BirdSkinPreview Skin="{Binding SavedSkin}" Margin="7" InputTransparent="True"
                                    AutomationProperties.IsInAccessibleTree="False" />
        </Grid>
      </Grid>
      <Border BackgroundColor="#152C45" StrokeThickness="0" StrokeShape="RoundRectangle 26" Padding="22,20">
        <Grid ColumnDefinitions="*,106" MinimumHeightRequest="132">
          <VerticalStackLayout Spacing="10" VerticalOptions="Center"><Label Text="МАЛЕНЬКАЯ ПТИЦА" TextColor="#86D9CA" FontSize="10" CharacterSpacing="1.4" FontAttributes="Bold" /><Label Text="Поймай&#10;свой ритм" FontSize="28" FontAttributes="Bold" TextColor="White" LineHeight="1.0" /><Label Text="Касание — взмах" TextColor="#C3D3E3" FontSize="12" /></VerticalStackLayout>
          <Image Grid.Column="1" Source="flight_hero.svg" Aspect="AspectFit" />
        </Grid>
      </Border>
      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
        <Border Style="{StaticResource Card}" Padding="16"><VerticalStackLayout Spacing="4"><Label Text="ЛУЧШИЙ СЧЁТ" Style="{StaticResource Eyebrow}" FontSize="9" /><Label Text="{Binding BestScore}" FontSize="34" FontAttributes="Bold" /><Label Text="{Binding DifficultyName}" Style="{StaticResource Subtitle}" FontSize="12" /></VerticalStackLayout></Border>
        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16"><VerticalStackLayout Spacing="4"><Label Text="ВСЕГО ПОЛЁТОВ" Style="{StaticResource Eyebrow}" FontSize="9" /><Label Text="{Binding Attempts}" FontSize="34" FontAttributes="Bold" /><Label Text="В твоей истории" Style="{StaticResource Subtitle}" FontSize="12" /></VerticalStackLayout></Border>
      </Grid>
      <VerticalStackLayout Spacing="10"><Label Text="Твой уровень" FontSize="18" FontAttributes="Bold" />
<Border BackgroundColor="White" Stroke="{StaticResource Line}" StrokeShape="RoundRectangle 18" Padding="5"><Grid ColumnDefinitions="*,*,*" ColumnSpacing="4" IsEnabled="{Binding CanInteract}"><Button Grid.Column="0" Text="Лёгкий" Style="{StaticResource SegmentButton}" Command="{Binding SelectDifficultyCommand}" CommandParameter="Easy" SemanticProperties.Description="Уровень: Лёгкий">
          <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsEasy}" Value="True"><Setter Property="BackgroundColor" Value="{StaticResource Accent}" /><Setter Property="TextColor" Value="White" /></DataTrigger></Button.Triggers>
        </Button><Button Grid.Column="1" Text="Обычный" Style="{StaticResource SegmentButton}" Command="{Binding SelectDifficultyCommand}" CommandParameter="Normal" SemanticProperties.Description="Уровень: Обычный">
          <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsNormal}" Value="True"><Setter Property="BackgroundColor" Value="{StaticResource Accent}" /><Setter Property="TextColor" Value="White" /></DataTrigger></Button.Triggers>
        </Button><Button Grid.Column="2" Text="Сложный" Style="{StaticResource SegmentButton}" Command="{Binding SelectDifficultyCommand}" CommandParameter="Hard" SemanticProperties.Description="Уровень: Сложный">
          <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsHard}" Value="True"><Setter Property="BackgroundColor" Value="{StaticResource Accent}" /><Setter Property="TextColor" Value="White" /></DataTrigger></Button.Triggers>
        </Button></Grid></Border>
        <Label Text="{Binding DifficultyDescription}" Style="{StaticResource Subtitle}" />
      </VerticalStackLayout>
      <Button Text="Начать полёт  →" Command="{Binding StartCommand}" IsEnabled="{Binding CanInteract}" HeightRequest="58" />
      <Border Style="{StaticResource Card}" Padding="16">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><VerticalStackLayout Spacing="4" VerticalOptions="Center"><Label Text="Маленькие победы" FontAttributes="Bold" FontSize="16" /><Label Text="{Binding AchievementsSummary}" Style="{StaticResource Subtitle}" FontSize="12" /></VerticalStackLayout><Button Grid.Column="1" Text="Достижения →" Command="{Binding AchievementsCommand}" Style="{StaticResource GhostButton}" FontSize="12" Padding="8" /></Grid>
      </Border>
      <Button Text="Таблица лучших полётов" Command="{Binding LeaderboardCommand}" Style="{StaticResource SecondaryButton}" />
      <controls:StatusBanner />
    </VerticalStackLayout>
  </ScrollView>
    <Grid IsVisible="{Binding IsSkinPickerOpen}" BackgroundColor="#A6152C45" Padding="20" ZIndex="1">
      <Border Style="{StaticResource Card}" MaximumWidthRequest="440" HorizontalOptions="Fill" VerticalOptions="Center"
              IsEnabled="{Binding CanInteract}">
        <ScrollView>
          <VerticalStackLayout Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <Label Text="Скины птицы" FontSize="24" FontAttributes="Bold" VerticalOptions="Center"
                     SemanticProperties.HeadingLevel="Level1" />
              <Button Grid.Column="1" Text="×" WidthRequest="48" Style="{StaticResource SecondaryButton}"
                      Command="{Binding CloseSkinPickerCommand}" SemanticProperties.Description="Закрыть выбор скина" />
            </Grid>
            <controls:BirdSkinPreview Skin="{Binding DraftSkin}" HeightRequest="48" InputTransparent="True"
                                      AutomationProperties.IsInAccessibleTree="False" />
            <VerticalStackLayout Spacing="6" RadioButtonGroup.GroupName="BirdSkins"
                                 RadioButtonGroup.SelectedValue="{Binding DraftSkinId, Mode=TwoWay}"
                                 BindableLayout.ItemsSource="{Binding Skins}">
              <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="models:BirdSkin">
                  <RadioButton Content="{Binding Name}" Value="{Binding Id}" BackgroundColor="{Binding Body}"
                               TextColor="#102A43" FontAttributes="Bold" MinimumHeightRequest="48" />
                </DataTemplate>
              </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <controls:StatusBanner />
            <Button Text="Сохранить" Command="{Binding SaveSkinCommand}" />
          </VerticalStackLayout>
        </ScrollView>
      </Border>
    </Grid>
  </Grid>
</ContentPage>
